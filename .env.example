# MongoDB Connection String
# Local: mongodb://localhost:27017/deepfake_db
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority&appName=ClusterName
DATABASE_URL=mongodb://localhost:27017/deepfake_db

# API Settings
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Admin Credentials (CHANGE IN PRODUCTION!)
ADMIN_EMAIL=admin@deepfake.com
ADMIN_PASSWORD=admin123

# Email (Resend)
EMAIL_API_KEY=your_resend_api_key
FROM_EMAIL=onboarding@resend.dev

# CORS & External URLs
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
MODEL_API_URL=http://localhost:5000
MODEL_API_URLS=

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=104857600

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=price_your_pro_monthly_price_id
STRIPE_PRICE_PRO_YEARLY=price_your_pro_yearly_price_id
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_your_enterprise_monthly_price_id
STRIPE_PRICE_ENTERPRISE_YEARLY=price_your_enterprise_yearly_price_id
